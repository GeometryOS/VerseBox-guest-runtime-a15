+              (unsigned)(ctx)->m_state->currentVertexArrayObject(), \
+              (unsigned)(ctx)->m_state->currentIndexVbo(), \
+              (unsigned)(ctx)->m_state->getLastEncodedBufferBind(GL_ELEMENT_ARRAY_BUFFER)); \
+        (ctx)->setError(GL_INVALID_OPERATION); \
+        return; \
+    }
